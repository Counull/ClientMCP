<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ClientMcpRuntimeRoot Condition="'$(ClientMcpRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)../../Project/Packages/com.counull.clientmcp/Runtime</ClientMcpRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ClientMcp.Server.csproj" />
    <Compile Include="$(ClientMcpRuntimeRoot)/RelayConnection.cs" Link="Shared/RelayConnection.cs" />
  </ItemGroup>
</Project>
